/**
 * services-content.ts
 * دیتابیس محتوایی ۲۰ خدمت پلتفرم خدمات الکترونیک (لندینگ‌پیج، سئو و Schema Markup)
 *
 * نکته فنی: faqSchema هر خدمت با تابع buildFaqSchema مستقیماً از همان آرایه faqs ساخته می‌شود
 * تا متن FAQ در UI و JSON-LD همیشه یکسان بماند (الزام گوگل برای FAQPage).
 *
 * نکته محتوایی: مبالغ، مهلت‌ها و آدرس سامانه‌ها توسط نهادهای دولتی به‌روزرسانی می‌شوند؛
 * متن‌ها عمداً بدون درج مبلغ ثابت نوشته شده‌اند. پیش از انتشار، مهلت‌های سال جاری را بررسی کنید.
 */

export interface ServiceFaq {
  question: string;
  answer: string;
}

export interface ServiceFaqSchema {
  "@context": string;
  "@type": string;
  mainEntity: {
    "@type": string;
    name: string;
    acceptedAnswer: {
      "@type": string;
      text: string;
    };
  }[];
}

export interface ServiceContentItem {
  slug: string;
  pageTitle: string; // جذاب و سئومحور، دقیقاً زیر ۶۰ کاراکتر
  metaDescription: string; // ترغیب‌کننده با کلمات کلیدی، زیر ۱۶۰ کاراکتر
  shortIntro: string; // ۲ یا ۳ جمله روان درباره مشکل واقعی کاربر و راهکار پلتفرم
  requiredDocuments: string[]; // مدارک دقیق و واقعی مورد نیاز
  processingSteps: string[]; // مراحل ۴ گانه انجام کار
  faqs: ServiceFaq[]; // حداقل ۴ پرسش و پاسخ کاملاً بومی، واقعی و تخصصی
  schemaData: {
    serviceType: string;
    faqSchema: ServiceFaqSchema;
  };
}

export function buildFaqSchema(faqs: ServiceFaq[]): ServiceFaqSchema {
  return {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  };
}

function defineService(
  item: Omit<ServiceContentItem, "schemaData"> & { serviceType: string }
): ServiceContentItem {
  const { serviceType, ...rest } = item;
  return {
    ...rest,
    schemaData: {
      serviceType,
      faqSchema: buildFaqSchema(rest.faqs),
    },
  };
}

